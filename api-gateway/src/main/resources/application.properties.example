spring.application.name=api-gateway
server.port=5000

eureka.client.service-url.defaultZone=${EUREKA_SERVER_URL:http://localhost:8000/eureka/}
eureka.client.register-with-eureka=true
eureka.client.fetch-registry=true
eureka.instance.prefer-ip-address=true
eureka.instance.instance-id=${spring.application.name}:${server.port}

# ─── Downstream Microservice Routes (one route per service) ─────────────────

spring.cloud.gateway.server.webmvc.routes[0].id=user-service
spring.cloud.gateway.server.webmvc.routes[0].uri=lb://user-service
spring.cloud.gateway.server.webmvc.routes[0].predicates[0]=Path=/api/users/**

spring.cloud.gateway.server.webmvc.routes[1].id=organization-service
spring.cloud.gateway.server.webmvc.routes[1].uri=lb://organization-service
spring.cloud.gateway.server.webmvc.routes[1].predicates[0]=Path=/api/organizations/**

spring.cloud.gateway.server.webmvc.routes[2].id=otp-service
spring.cloud.gateway.server.webmvc.routes[2].uri=lb://otp-service
spring.cloud.gateway.server.webmvc.routes[2].predicates[0]=Path=/api/otp/**

# ─── JWT Configuration ────────────────────────────────────────────────────────
jwt.secret=${JWT_SECRET:your_base64_encoded_jwt_secret_key_minimum_256_bits_here}
jwt.access-token-expiration=${JWT_ACCESS_EXPIRATION:900000}
jwt.refresh-token-expiration=${JWT_REFRESH_EXPIRATION:604800000}
