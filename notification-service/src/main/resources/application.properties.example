spring.application.name=notification-service
server.port=5504

eureka.client.service-url.defaultZone=${EUREKA_SERVER_URL:http://localhost:8000/eureka/}
eureka.client.register-with-eureka=true
eureka.client.fetch-registry=true
eureka.instance.prefer-ip-address=true
eureka.instance.instance-id=${spring.application.name}:${server.port}

# ===================================================================
# Database Connection Configuration (PostgreSQL)
# ===================================================================
spring.datasource.url=${DB_URL:jdbc:postgresql://your-db-host:5432/your_database}
spring.datasource.username=${DB_USERNAME:your_db_username}
spring.datasource.password=${DB_PASSWORD:your_db_password}
spring.datasource.driver-class-name=org.postgresql.Driver

# ===================================================================
# JPA / Hibernate Configurations
# ===================================================================
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.default_schema=public

# ===================================================================
# HikariCP Connection Pool
# ===================================================================
spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.minimum-idle=2
spring.datasource.hikari.idle-timeout=300000
spring.datasource.hikari.max-lifetime=1200000
spring.datasource.hikari.connection-timeout=20000

# ===================================================================
# Aiven Kafka Notification Service Configuration
# ===================================================================
notification.service.url=${NOTIFICATION_SERVICE_URL:https://your-aiven-kafka-host:your_port}
notification.service.host=${NOTIFICATION_SERVICE_HOST:your-aiven-kafka-host}
notification.service.port=${NOTIFICATION_SERVICE_PORT:your_port}
notification.service.username=${NOTIFICATION_SERVICE_USER:your_aiven_username}
notification.service.password=${NOTIFICATION_SERVICE_PASSWORD:your_aiven_password}
notification.service.topic-email=${NOTIFICATION_TOPIC_EMAIL:TOPIC_EMAIL}
notification.service.topic-sms=${NOTIFICATION_TOPIC_SMS:TOPIC_SMS}
notification.service.topic-whatsapp=${NOTIFICATION_TOPIC_WHATSAPP:TOPIC_WHATSAPP}
