# =========================================================================
# Local Environment Variables Example (.env.example)
# =========================================================================
# Copy to .env (which is git-ignored) or configure in your deployment platform.
# =========================================================================

# ─── Aiven Kafka Notification Service ─────────────────────────────────────
NOTIFICATION_SERVICE_URL=https://your-aiven-kafka-host:your_port
NOTIFICATION_SERVICE_HOST=your-aiven-kafka-host
NOTIFICATION_SERVICE_PORT=your_port
NOTIFICATION_SERVICE_USER=your_aiven_username
NOTIFICATION_SERVICE_PASSWORD=your_aiven_password
NOTIFICATION_TOPIC_EMAIL=email
NOTIFICATION_TOPIC_SMS=sms
NOTIFICATION_TOPIC_WHATSAPP=whatsapp

